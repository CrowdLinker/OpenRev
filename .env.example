# --- OpenRev configuration (Node.js / Docker) -------------------------------
# Public URL of your OpenRev instance (used in emails, alerts and webhook URLs)
PUBLIC_URL=http://localhost:3000
# Encrypts payment provider secrets. Generate with: openssl rand -hex 32
OPENREV_SECRET=
# SQLite file (default ./data/openrev.db) or a PostgreSQL URL
# DATABASE_URL=postgres://user:password@localhost:5432/openrev
PORT=3000
# Disable public sign-ups after the first admin account (invites still work)
DISABLE_SIGNUP=false
# Optional: send emails (invites, alerts, digests) with Resend
RESEND_API_KEY=
OPENREV_EMAIL_FROM=OpenRev <analytics@example.com>
# Optional: delete raw events older than N days
RETENTION_DAYS=
# Optional: path to a MaxMind / DB-IP .mmdb file (otherwise DB-IP Lite is downloaded automatically)
# GEOIP_DB=/data/GeoLite2-City.mmdb
# GEOIP_AUTO_DOWNLOAD=true
